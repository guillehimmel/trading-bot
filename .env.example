# Claude API (para correr los agentes)
ANTHROPIC_API_KEY=
# Sonnet solo para el CEO (decisión final). Haiku para Mercado/Riesgo/Noticias
# (procesan datos, no necesitan el modelo caro) — esto es lo que mantiene el
# costo mensual bajo. Ver README para el detalle de costo.
ANTHROPIC_MODEL_CEO=claude-sonnet-5
ANTHROPIC_MODEL_WORKER=claude-haiku-4-5

# Telegram: creá un bot con @BotFather, te da el token.
# El chat_id es tu ID de usuario o el del grupo (hablale al bot y consultá
# https://api.telegram.org/bot<TOKEN>/getUpdates para verlo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Universo y riesgo
UNIVERSE_SIZE=5
MIN_RISK_REWARD=2.0
MAX_RISK_PER_TRADE_PCT=1.0
MAX_PORTFOLIO_RISK_PCT=5.0
ACCOUNT_EQUITY_USD=10000
